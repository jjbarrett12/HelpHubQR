# Supabase (create project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: for Edge Functions (set in Supabase Dashboard → Edge Functions → Secrets)
# SUPABASE_SERVICE_ROLE_KEY=...
# Required for Platform Admin: change user email/password. Get from Supabase Dashboard → Settings → API → service_role (secret).
# For send-alerts: Twilio and/or SendGrid
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1234567890
# SENDGRID_API_KEY=...
# ALERT_FROM_EMAIL=alerts@yourdomain.com
# DASHBOARD_URL=https://yourdomain.com

# App URL (for QR links, redirects, and metadata)
# Production: https://helphubqr.com (set in Vercel → Settings → Environment Variables)
# Local dev: set to http://localhost:3000 if you run npm run dev locally
NEXT_PUBLIC_APP_URL=https://helphubqr.com

# Calendly: "See it in action" / demo button link (e.g. https://calendly.com/your-username/demo)
# If not set, demo button scrolls to #demo section or uses mailto fallback on CTA
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-link

# Push notifications (Web Push / VAPID) – same public key as in Supabase Edge Function secrets
# Generate keys: npx web-push generate-vapid-keys
# Set NEXT_PUBLIC_VAPID_PUBLIC_KEY here; set VAPID_PUBLIC_KEY and VAPID_PRIVATE_KEY in Supabase Dashboard → Edge Functions → Secrets
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=...

# Checklist import (photo → OCR → AI → review). Server-only OpenAI; never expose OPENAI_API_KEY to the client.
# SUPABASE_SERVICE_ROLE_KEY is required for private bucket uploads and signed preview URLs.
# OPENAI_API_KEY=sk-...
# IMPORT_OCR_PROVIDER=openai_vision   # or leave empty / "none" to fail fast with a clear config message
# OPENAI_IMPORT_VISION_MODEL=gpt-4o-mini
# OPENAI_IMPORT_TEXT_MODEL=gpt-4o-mini

# MVP (Hotel Ops): staff JWT + device fingerprint + proof uploads
# Required for /api/staff/auth and /api/tasks/event with staff JWT
# STAFF_JWT_SECRET=...   (min 16 chars; used to sign staff session JWT)
# PROPERTY_SALT_SECRET=... (used for device install_id hashing; server-only)
# UPLOAD_BUCKET=proof    (Supabase Storage bucket for proof-of-work photos)

# Distributed rate limits (recommended for multi-instance production). If unset, guest limits use in-memory fallback; authed limits use per-instance memory caps.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=...

# Optional error tracking for API routes (install @sentry/node or use Sentry wizard); captureServerException no-ops without DSN.
# SENTRY_DSN=https://...@sentry.io/...

# Checklist SMS/email delivery (server-only). SUPABASE_SERVICE_ROLE_KEY required for cron job.
# CRON_SECRET=long-random-string
# CRON_SCHEDULE_TZ=America/New_York
# Optional: require Vercel cron header in addition to CRON_SECRET (set on Vercel prod).
# CRON_REQUIRE_VERCEL_HEADER=1
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+15551234567
# RESEND_API_KEY=re_...   # or SENDGRID_API_KEY
# CHECKLIST_FROM_EMAIL=checklists@yourdomain.com
# ALERT_FROM_EMAIL=...    # fallback if CHECKLIST_FROM_EMAIL unset
