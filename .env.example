# Supabase (create project at supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Optional: for Edge Functions (set in Supabase Dashboard → Edge Functions → Secrets)
# SUPABASE_SERVICE_ROLE_KEY=...
# For send-alerts: email (Resend or SendGrid), SMS (Twilio), push (VAPID)
# RESEND_API_KEY=re_...           # preferred for email
# SENDGRID_API_KEY=...
# ALERT_FROM_EMAIL=alerts@yourdomain.com
# TWILIO_ACCOUNT_SID=...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+1234567890
# VAPID_PUBLIC_KEY=...            # Web Push (set in Supabase Edge Function secrets)
# VAPID_PRIVATE_KEY=...
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=... # same as VAPID_PUBLIC_KEY (for browser)
# DASHBOARD_URL=https://yourdomain.com  # production: same as NEXT_PUBLIC_APP_URL for alert links

# App URL (for QR links and redirects)
# Local dev: http://localhost:3010
# Production: set to your domain (e.g. https://helphub.yourdomain.com)
NEXT_PUBLIC_APP_URL=http://localhost:3010
